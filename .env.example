# Postgres connection string. Local dev uses the Homebrew Postgres 14 instance.
DATABASE_URL=postgresql://localhost:5432/atelier_dev

# Session cookie signing secret (32+ chars). Generate: openssl rand -hex 32
COOKIE_SECRET=

# Optional: signing secret for the /panel admin session (32+ chars). Unset, a
# distinct key is derived from COOKIE_SECRET, so the panel and the customer
# session cookie never share one. Set it to rotate panel sessions on their own.
# ADMIN_SESSION_SECRET=

# Skip AdminJS's boot-time bundling of user components. Under NODE_ENV=production
# AdminJS writes a .adminjs/ directory into the working directory; set this to
# true wherever that directory is not writable. The panel fails soft (the API
# keeps serving and logs why), but /panel stays down until this is resolved.
# No user components are configured, so skipping costs nothing.
# ADMIN_JS_SKIP_BUNDLE=true

# Stripe secret key (test mode: sk_test_...). Card checkout is disabled if unset.
# NEVER commit a real key — this file documents the name only.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...). POST /webhooks/stripe returns 503
# until set. From `stripe listen` locally or the dashboard endpoint. Env only.
STRIPE_WEBHOOK_SECRET=

# Storefront base URL for Stripe success/cancel redirects (default shown). It is
# also a CORS-allowed origin, because the storefront islands fetch this API from
# the browser with the session cookie.
# STORE_BASE_URL=http://localhost:4321

# Back-office CRM base URL (default shown). CORS only — the CRM is a second
# browser app calling this API with the session cookie, and its own port makes it
# a distinct origin. Wrong or unset in production and every CRM screen is blocked
# by the browser, including sign-in.
# CRM_BASE_URL=http://localhost:5273

# Email / SMTP (US-015). With SMTP_HOST unset, mail is CAPTURED, never sent —
# the default for local dev and CI: each letter is printed to the API's log
# instead (so a reset link can be followed from the console), and the two
# password-reset routes answer 503 rather than claim a letter is on its way.
# STAGING AND PRODUCTION NEED ALL SEVEN: order mail, the contact form, the
# trade-application alert and "Forgot your password?" all deliver through this
# and nothing else. Setting SMTP_HOST without EMAIL_FROM + BACKOFFICE_EMAIL
# refuses to boot: the placeholder defaults are not a sender Postmark accepts.
#
# Production is Postmark over SMTP (no SDK, nodemailer speaks it natively):
#   host smtp.postmarkapp.com, port 587 (STARTTLS; 2525 if 587 is blocked),
#   SMTP_USER and SMTP_PASS BOTH = the Server API token of the transactional
#   ("outbound") stream, with SMTP access enabled on that stream. From must be
#   on the verified sender signature / domain — atelier.co.nz once its DKIM and
#   Return-Path DNS records are added and verified in Postmark.
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# Sender + back-office notification address. Every alert (new order, new
# enquiry, new trade application) goes to the ONE back-office address, with
# Reply-To set to the client so staff can answer from the inbox.
# EMAIL_FROM=Atelier Textiles <no-reply@atelier.co.nz>
# BACKOFFICE_EMAIL=orders@atelier.co.nz
#
# Copied on EVERY letter about a sales order — each status change and the
# order page's "Email order details" / "Resend" buttons — whoever else the order
# names. Defaults to jenettec@atelier.co.nz (the client's instruction); set it
# to another address to move the copy, or to empty to send no copy.
# ORDER_COPY_EMAIL=jenettec@atelier.co.nz
#
# The trade application review. A new application asks TRADE_APPROVER_EMAIL to
# approve or decline it; her approval asks TRADE_ACCOUNTS_EMAIL for the final
# approval. Each address is also the ONLY login allowed to take its step.
# Empty = any back-office login may (and the first alert goes to
# BACKOFFICE_EMAIL, the second to nobody).
# TRADE_APPROVER_EMAIL=elizabethd@atelier.co.nz
# TRADE_ACCOUNTS_EMAIL=jenettec@atelier.co.nz
#
# THE TEST-DRIVE VALVE. Set it and EVERY letter is delivered to this one
# address instead of the one it names — the client's, orders@atelier.co.nz, and
# a SUPPLIER's po_email alike — with the intended recipient in the subject and
# a banner at the top of the body. server.js warns loudly on boot while it is
# set. It exists because purchasing and reserves write to people outside the
# business: a purchase order goes to a fabric house and a reserve request asks
# a mill to hold stock, so a letter still being tuned must not reach one.
# While it is set, Xero is also never asked to email an invoice (Xero mails the
# client directly, round this valve).
# DEFAULTS TO ibrahim@verum.nz while the platform is being tested, so leaving it
# out of .env does NOT send real mail. SET IT TO EMPTY TO GO LIVE, at which
# point clients and suppliers start receiving letters for real.
# EMAIL_REDIRECT_TO=ibrahim@verum.nz

# Newsletter (Mailchimp). All three or nothing: unset, POST /newsletter answers
# 503 and the storefront footer says sign-up is not available yet, and a trade
# application's "Yes" to Mailchimp notifications signs nobody up. SERVER is
# the data-centre suffix of the API key (`...-us21` → us21). Audience ID is
# under Audience → Settings → Audience name and defaults.
# MAILCHIMP_API_KEY=
# MAILCHIMP_SERVER=us21
# MAILCHIMP_AUDIENCE_ID=

# Image upload (POST /admin/media, the CRM's image fields). Unset, the route
# answers 503 and staff paste a link instead. The file is handed to EmDash, the
# storefront's media library, and served from STORE_BASE_URL. EMDASH_URL is the
# storefront's INTERNAL address (same host: http://127.0.0.1:4321 — skips nginx
# and the staging Basic Auth). EMDASH_TOKEN: EmDash admin -> API tokens, with
# media read + upload. nginx in front of the API must allow a 10 MB body on
# /admin/media (`client_max_body_size 10m;`) or photos 413 at the proxy.
# EMDASH_URL=http://127.0.0.1:4321
# EMDASH_TOKEN=

# Xero (C4). Unset, the integration is disabled and every /admin/xero route
# answers 503. Two ways to connect:
#   - authorization_code (default): any Xero app; a DIRECTOR clicks Connect in
#     the CRM once and consents. XERO_REDIRECT_URI must EXACTLY match a
#     redirect URI registered on the Xero app (production: the public API
#     origin + /admin/xero/callback).
#   - client_credentials: a paid Xero "Custom Connection"; no consent step.
# NEVER commit real credentials — names only, values in the environment.
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_GRANT_TYPE=authorization_code
# XERO_REDIRECT_URI=http://localhost:3001/admin/xero/callback
# Revenue account invoices post to (Xero's stock "Sales" account is 200) and
# how line amounts are stated. NZ trade invoices are conventionally
# GST-exclusive; set Inclusive only after confirming with the accountant.
# XERO_SALES_ACCOUNT_CODE=200
# XERO_LINE_AMOUNT_TYPES=Exclusive
# Pushed invoices are AUTHORISED (ready to send). Set DRAFT for a cautious
# rollout — but Xero cannot EMAIL a draft, so the email option stops working.
# XERO_INVOICE_STATUS=AUTHORISED
# XERO_INVOICE_DUE_DAYS=30
# The BANK account (its Xero account code) a payment is recorded against when
# an order is marked paid in the CRM — the invoice then shows PAID in Xero.
# Unset, invoices are still pushed but never marked paid from here.
# XERO_PAYMENT_ACCOUNT_CODE=
# Purchase orders push as BILLS against the house's Xero contact when they are
# sent: the expense account they post to (Xero's stock "Purchases" is 300) and
# the status they land in. DRAFT by default — the accountant approves once the house's own
# invoice arrives. AUTHORISED puts the ordered amount on the payables ledger
# at once.
# XERO_PURCHASES_ACCOUNT_CODE=300
# XERO_BILL_STATUS=DRAFT
# Xero → platform pull (contacts both ways, invoice + bill statuses so a
# PAID invoice marks its order paid here). Minutes between automatic pulls;
# 0 or unset = only when a staff member clicks Pull on the CRM's Xero screen.
# XERO_PULL_INTERVAL_MINUTES=0

# Client-facing per-house trade price lists (GET /account/price-lists in the
# storefront's account portal). OFF unless set to exactly 'true'.
#
# This is a BUSINESS gate, not a rollout convenience. `products.trade_price_cents`
# is still seeded from the demo pricing snapshot — 8 of the 12 seeded fabrics
# carry the identical NZ$187.76 and no finished good carries one — and a
# downloadable price list is a document a designer quotes a job from. Turn it on
# when the figures are real, not before.
# TRADE_PRICE_LISTS_ENABLED=true

# Optional overrides (defaults shown)
# PORT=3001
# HOST=127.0.0.1
# LOG_LEVEL=info

# Set when running behind a reverse proxy (nginx/RunCloud) so request.ip is the
# real client and per-IP rate limiting works. Use the proxy's address, not
# 'true' (which trusts any client-supplied X-Forwarded-For).
# TRUST_PROXY=127.0.0.1
