node_modules/

# AdminJS writes bundled user components here at boot under NODE_ENV=production.
# Build artefact, regenerated every start — and the reason the panel needs a
# writable working directory (or ADMIN_JS_SKIP_BUNDLE=true).
.adminjs/

.env
.env.*
!.env.example
incoming/
# Database dumps staged for a server restore. These are the customer database in
# plaintext (names, addresses, order history) — the same reason incoming/ is
# ignored. A dump lands here on its way to a server and must never reach GitHub.
sql/
.DS_Store

# Ralph loop scratch. prd.json, progress.txt, CLAUDE.md and the verify logs ARE
# committed — they are the audit trail. These two are per-run machine state.
ralph/*/.last-branch
ralph/*/archive/
