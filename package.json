{
  "name": "atelier-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Atelier platform API \u2014 Fastify + Postgres backend for the storefront and back office.",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node-pg-migrate --migrations-dir migrations --migration-file-language js up",
    "migrate:down": "node-pg-migrate --migrations-dir migrations --migration-file-language js down",
    "migrate:create": "node-pg-migrate --migrations-dir migrations --migration-file-language js create",
    "seed": "node src/seed/run.js",
    "seed:staff": "node src/seed/seed-staff.js",
    "seed:reserves": "node src/seed/seed-reserves.js",
    "convert:pricing": "node scripts/convert-price-lists.js",
    "import:pricing": "node src/seed/import-price-lists.js",
    "backfill:suppliers": "node src/seed/backfill-suppliers.js",
    "convert:colour": "node scripts/convert-colour-files.js",
    "import:colour": "node src/seed/import-colourways.js",
    "convert:legacy": "node scripts/convert-d365-exports.js",
    "sheet:prices": "node scripts/export-category-sheets.js prices",
    "sheet:stock": "node scripts/export-category-sheets.js stock",
    "import:legacy": "node src/seed/import-legacy.js",
    "import:item-types": "node src/seed/import-stock-item-types.js",
    "push:legacy": "node src/seed/push-legacy.js",
    "lint": "eslint .",
    "test": "vitest run",
    "backfill:pricing-parameters": "node src/seed/backfill-pricing-parameters.js"
  },
  "dependencies": {
    "@adminjs/fastify": "^4.2.0",
    "@adminjs/sql": "^2.2.6",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/session": "^11.1.2",
    "adminjs": "^7.8.17",
    "argon2": "^0.45.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.1",
    "node-pg-migrate": "^7.9.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.1",
    "stripe": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "agentation": "^3.0.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "vitest": "^2.1.9"
  }
}
